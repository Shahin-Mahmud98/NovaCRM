# Copy this file to .env and adjust as needed. .env is gitignored, so your
# real secrets/credentials never get committed.

# --- Database -----------------------------------------------------------
# If DATABASE_URL is unset (or this whole file is missing), the project
# falls back to a local SQLite file automatically — nothing else breaks.
#
# For local Postgres installed directly on your machine:
DATABASE_URL=postgres://novacrm_user:novacrm_pass@127.0.0.1:5432/novacrm_db
#
# For the docker-compose Postgres service included in this project, use
# this instead (same credentials, defined in docker-compose.yml):
# DATABASE_URL=postgres://novacrm_user:novacrm_pass@localhost:5432/novacrm_db

# --- Django core ----------------------------------------------------------
SECRET_KEY=django-insecure-change-this-for-any-real-deployment
DEBUG=True
ALLOWED_HOSTS=*

# --- AI features (Reports/contact/deal AI assist, chat assistant) --------
# Optional — without this, AI buttons show a friendly "not configured"
# message instead of an error. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
